{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": { "type": "none" },

  "display": {
    "separator": "  ",
    "color": { "keys": "34", "title": "32" },
    "key": { "width": 16 }
  },

  "modules": [
    {
      "type": "title",
      "format": "    \u001b[32;1m{user-name}\u001b[90m @ \u001b[34;1m{host-name}\u001b[0m"
    },
    { "type": "custom", "format": "    \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "os",       "key": "    \uf303  OS"      },
    { "type": "kernel",   "key": "    \uf17c  Kernel"  },
    { "type": "shell",    "key": "    \ue691  Shell"   },
    { "type": "uptime",   "key": "    \udb80\udc51  Uptime"  },
    { "type": "packages", "key": "    \udb80\udcc6  Pkgs"    },
    { "type": "custom", "format": "    \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    {
      "type": "cpu",
      "key": "    \uf4bc  CPU",
      "format": "{name} ({cores-logical}T)"
    },
    {
      "type": "gpu",
      "key": "    \udb84\udc01  GPU",
      "format": "{name}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "    \udb80\udcd8  RAM",
      "percent": { "type": 9, "green": 60, "yellow": 80 }
    },
    {
      "type": "disk",
      "key": "    \udb82\udcb2  Root",
      "folders": "/",
      "percent": { "type": 9, "green": 60, "yellow": 80 }
    },
    {
      "type": "disk",
      "key": "    \udb81\udcf7  Home",
      "folders": "/home",
      "percent": { "type": 9, "green": 60, "yellow": 80 }
    },
    { "type": "custom", "format": "    \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "colors", "symbol": "block", "paddingLeft": 4 }
  ]
}

